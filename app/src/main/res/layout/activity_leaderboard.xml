<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LeaderboardActivity">

    <!-- BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/leaderboard_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🏠 ЗАГЛАВИЕ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="РЕЗУЛТАТ"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="32dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>

            <!-- 📦 MAIN CONTAINER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#D9FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ТВОЯ РЕЗУЛТАТ SECTION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="#1A3F51B5">

                        <TextView
                            android:id="@+id/tvYourResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Точки: 0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/tvYourPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Вашето място: -"
                            android:textSize="18sp"
                            android:textColor="#555555"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#33000000"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"/>

                    <!-- КЛАСИРАНЕ TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Седмично класиране"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="12dp"/>

                    <!-- SCROLLABLE LIST WITH FIXED HEADER -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <!-- Header Row -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="#33000000"
                                android:paddingVertical="10dp">
                                <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:textColor="#000000" android:gravity="center"/>
                                <TextView android:layout_width="170dp" android:layout_height="wrap_content" android:text="Потребител" android:textStyle="bold" android:textColor="#000000" android:paddingStart="10dp"/>
                                <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="Точки" android:textStyle="bold" android:textColor="#000000" android:gravity="center"/>
                                <TextView android:layout_width="65dp" android:layout_height="wrap_content" android:text="Време" android:textStyle="bold" android:textColor="#000000" android:gravity="center"/>
                            </LinearLayout>
                            <ScrollView
                                android:id="@+id/scrollLeaderboard"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:background="#12000000">
                                <LinearLayout
                                    android:id="@+id/leaderboardContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </ScrollView>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnHome"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Начало"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#3700B3"
                        android:layout_marginTop="24dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
